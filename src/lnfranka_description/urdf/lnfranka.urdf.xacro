          </geometry>
        </collision>
        <collision>
          <origin xyz="0 0 -0.07" rpy="0 0 0"/>
          <geometry>
            <sphere radius="${0.06+0}" />
          </geometry>
        </collision> -->
      </link>
    
      <joint name="joint3" type="revolute">
        <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-2.8973" soft_upper_limit="2.8973"/>
        <origin rpy="${pi/2} 0 0" xyz="0 -0.316 0"/>
        <parent link="link2"/>
        <child link="link3"/>
        <axis xyz="0 0 1"/>
        <limit effort="87" lower="-2.8973" upper="2.8973" velocity="2.1750"/>
      </joint>

      <link name="link4">
        <!-- <xacro:default_inertial mass="0.1"/> -->
        <inertial>
          <origin rpy="0 0 0" xyz="-0.0360505 0.0337069 0.0319019"/>
          <mass value="2.3104763646281508"/>
          <inertia ixx="0.007764568814864828" ixy="0.003371475204045935" ixz="-0.002343621113168248" iyy="0.008015776929980149" iyz="0.0022917526161470624" izz="0.009955882308071066"/>
        </inertial>
        <visual>
          <geometry>
            <mesh filename="package://lnfranka_description/meshes/link4.dae" scale="1.0 1.0 1.0"/>
          </geometry>
        </visual>
        <!-- <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <cylinder radius="${0.06+0}" length="0.12" />
          </geometry>
        </collision>
        <collision>
          <origin xyz="0 0 0.06" rpy="0 0 0"/>
          <geometry>
            <sphere radius="${0.06+0}" />
          </geometry>
        </collision>
        <collision>
          <origin xyz="0 0 -0.06" rpy="0 0 0"/>
          <geometry>
            <sphere radius="${0.06+0}" />
          </geometry>
        </collision> -->
      </link>

    <joint name ="joint4" type="revolute">
        <parent link="link3"/>
        <child link = "link4"/>
        <origin rpy="${pi/2} 0 0" xyz="0.0825 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.0718" upper="-0.0698" 
               effort="${effort}" velocity="${velocity}"/>
    </joint>

    <link name="link5">
      <!-- <xacro:default_inertial mass="0.1"/> -->
      <inertial>
        <origin rpy="0 0 0" xyz="-6.12525e-06 0.0610427 -0.104176"/>
        <mass value="2.6226426154892004"/>
        <inertia ixx="0.029070538014399377" ixy="6.208738268725568e-07" ixz="-1.0059151925023392e-05" iyy="0.027638529986528795" iyz="-0.007424306477850814" izz="0.004251111234400737"/>
