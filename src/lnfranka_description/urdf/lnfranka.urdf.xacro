      </collision>
      <collision>
        <origin xyz="0 0 -0.06" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${0.04+safety_distance}"  />
        </geometry>
      </collision> -->
    </link>

    <joint name="joint7" type="revolute">
      <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-2.8973" soft_upper_limit="2.8973"/>
      <origin rpy="${pi/2} 0 0" xyz="0.088 0 0"/>
      <parent link="link6"/>
      <child link="link7"/>
      <axis xyz="0 0 1"/>
      <limit effort="12" lower="-2.8973" upper="2.8973" velocity="2.6100"/>
    </joint>

    <link name="link8">
      <xacro:default_inertial mass="0.1"/>
      <collision>
        <origin xyz="0.0424 0.0424 -0.0250" rpy="${pi} ${pi/2} ${pi/2}"/>
        <geometry>
          <cylinder radius="${0.03+0}"  length="0.01" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0.0424 0.0424 -0.02" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${0.03+0}"  />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0.0424 0.0424 -0.03" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${0.03+0}"  />
        </geometry>
      </collision>
    </link>

    <joint name="joint8" type="fixed">
      <origin rpy="0 0 0" xyz="0 0 0.107"/>
      <parent link="link7"/>
      <child link="link8"/>
      <limit effort="12" lower="-2.8973" upper="2.8973" velocity="2.6100"/>
    </joint>

    <link name="hand">
      <!-- <xacro:default_inertial mass="0.1"/> -->
      <inertial>
        <origin rpy="0 0 0" xyz="-6.7624e-06 0.00152435 0.0275912"/>
        <mass value="0.14060765127978503"/>
        <inertia ixx="0.0005365450414352072" ixy="1.7911952957732454e-08" ixz="-2.320071910601251e-08" iyy="7.70511954783727e-05" iyz="4.681149945315967e-08" izz="0.0004938176882694914"/>
      </inertial>
      <visual>
          <geometry>
            <mesh filename="package://lnfranka_description/meshes/hand.dae"/>
          </geometry>
        </visual>
      <!-- <collision>
        <origin xyz="0 0 0.04" rpy="0 ${pi/2} ${pi/2}"/>
        <geometry>
          <cylinder radius="${0.04+safety_distance}" length="0.1"/>
        </geometry>
      </collision>
