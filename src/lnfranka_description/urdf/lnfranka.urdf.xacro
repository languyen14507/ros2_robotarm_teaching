    </link>

    <joint name="hand_joint" type="fixed">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <parent link="link8"/>
      <child link="hand"/>
    </joint>    


    <!-- Define the hand_tcp frame -->
    <link name="hand_tcp">
    </link>

    <joint name="hand_tcp_joint" type="fixed">
      <origin xyz="0 0 0.1034" rpy="0 0 0"/>
      <parent link="hand"/>
      <child link="hand_tcp"/>
      <!-- <limit effort="12" lower="-2.8973" upper="2.8973" velocity="2.6100"/> -->
    </joint>

    <link name="leftfinger">
      <!-- <xacro:default_inertial mass="0.1"/> -->
      <inertial>
        <origin rpy="0 0 0" xyz="-6.2561e-06 0.00227781 -0.0277116"/>
        <mass value="0.2238453537819424"/>
        <inertia ixx="6.74804167363695e-05" ixy="-4.1027443646025676e-09" ixz="1.8693673970152995e-08" iyy="6.627189221641395e-05" iyz="1.1967548474390802e-05" izz="1.550396267804825e-05"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://lnfranka_description/meshes/finger.dae"/>
        </geometry>
      </visual>
    </link>
    <link name="rightfinger">
      <!-- <xacro:default_inertial mass="0.1"/> -->
      <inertial>
        <origin rpy="0 0 3.141592653589793" xyz="-6.2561e-06 0.00227781 -0.0277116"/>
        <mass value="0.2238453537819424"/>
        <inertia ixx="6.74804167363695e-05" ixy="-4.1027443646025676e-09" ixz="1.8693673970152995e-08" iyy="6.627189221641395e-05" iyz="1.1967548474390802e-05" izz="1.550396267804825e-05"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 ${pi}"/>
        <geometry>
          <mesh filename="package://lnfranka_description/meshes/finger.dae"/>
        </geometry>
      </visual>
    </link>
    <joint name="finger_joint1" type="prismatic">
      <parent link="hand"/>
      <child link="leftfinger"/>
      <origin xyz="0 0 0.0584" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="20" lower="0.0" upper="0.04" velocity="0.2"/>
    </joint>
    <joint name="finger_joint2" type="prismatic">
      <parent link="hand"/>
      <child link="rightfinger"/>
      <origin xyz="0 0 0.0584" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="20" lower="-0.04" upper="0.0" velocity="0.2"/>
      <mimic joint="finger_joint1" multiplier="-1"/>
    </joint>

    <gazebo reference="link0">
      <material>Gazebo/Orange</material>
    </gazebo>
    <gazebo reference="link1">
      <material>Gazebo/Green</material>
    </gazebo>
    <gazebo reference="link2">
      <material>Gazebo/Orange</material>
    </gazebo>
    <gazebo reference="link3">
      <material>Gazebo/White</material>
    </gazebo>
    <gazebo reference="link4">
      <material>Gazebo/Yellow</material>
    </gazebo>
    <gazebo reference="link5">
      <material>Gazebo/White</material>
    </gazebo>
    <gazebo reference="link6">
      <material>Gazebo/Green</material>
    </gazebo>
    <gazebo reference="link7">
      <material>Gazebo/Orange</material>
    </gazebo>    
    <gazebo reference="link8">
      <material>Gazebo/White</material>
    </gazebo>
    <gazebo reference="hand">
      <material>Gazebo/Yellow</material>
    </gazebo>
    <gazebo reference="rightfinger">
      <material>Gazebo/Red</material>
    </gazebo>
    <gazebo reference="leftfinger">
      <material>Gazebo/Red</material>
    </gazebo>  

    <!-- Transmissions-->
    <xacro:default_transmission number="1"/>
    <xacro:default_transmission number="2"/>
    <xacro:default_transmission number="3"/>
    <xacro:default_transmission number="4"/>
    <xacro:default_transmission number="5"/>
    <xacro:default_transmission number="6"/>
    <xacro:default_transmission number="7"/>
    <xacro:default_transmission number="8"/>   


</robot>
