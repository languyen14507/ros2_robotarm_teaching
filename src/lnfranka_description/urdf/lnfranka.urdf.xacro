    <joint name="joint5" type="revolute">
      <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-2.8973" soft_upper_limit="2.8973"/>
      <origin rpy="${-pi/2} 0 0" xyz="-0.0825 0.384 0"/>
      <parent link="link4"/>
      <child link="link5"/>
      <axis xyz="0 0 1"/>
      <limit effort="12" lower="-2.8973" upper="2.8973" velocity="2.6100"/>
    </joint>

    <link name="link6">
      <!-- <xacro:default_inertial mass="0.1"/> -->
      <inertial>
        <origin rpy="0 0 0" xyz="0.051051 0.00910797 0.0106343"/>
        <mass value="1.5025804886626795"/>
        <inertia ixx="0.002940555801469018" ixy="-0.00042391108351381507" ixz="0.000610007735338717" iyy="0.00392105201248677" iyz="0.00012647545430836214" izz="0.0054115603870960195"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://lnfranka_description/meshes/link6.dae"/>
        </geometry>
      </visual>
      <!-- <collision>
        <origin xyz="0 0 -0.03" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${0.05+safety_distance}" length="0.08" />
        </geometry>
      </collision>
